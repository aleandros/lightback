{
  "name": "@lightback/widget",
  "version": "0.2.5",
  "description": "Drop-in feedback widget for Lightback: element picker, notes, screenshot, review and send. Vanilla, Shadow DOM, framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lazy": {
      "import": {
        "types": "./dist/lazy.d.ts",
        "default": "./dist/lazy.js"
      },
      "require": {
        "types": "./dist/lazy.d.cts",
        "default": "./dist/lazy.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.iife.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lightback/core": "workspace:>=0.0.1 <0.3.0"
  },
  "devDependencies": {
    "@lightback/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aleandros/lightback.git",
    "directory": "packages/widget"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "unpkg": "./dist/lightback.iife.js",
  "jsdelivr": "./dist/lightback.iife.js",
  "typesVersions": {
    "*": {
      "lazy": [
        "./dist/lazy.d.ts"
      ]
    }
  }
}
