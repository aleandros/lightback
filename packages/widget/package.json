{
  "name": "@lightback/widget",
  "version": "0.0.1",
  "description": "Drop-in feedback widget for Lightback: element picker, notes, screenshot, review and send. Vanilla, Shadow DOM, framework-agnostic.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external @lightback/core",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@lightback/core": "workspace:*"
  },
  "devDependencies": {
    "@lightback/core": "workspace:*"
  }
}
