{
  "name": "@lightback/source",
  "version": "0.1.1",
  "description": "Build-time JSX, Vue and Svelte source locations for Lightback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite.d.ts"
      ],
      "babel": [
        "./dist/babel.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./babel": {
      "import": {
        "types": "./dist/babel.d.ts",
        "default": "./dist/babel.js"
      },
      "require": {
        "types": "./dist/babel.d.cts",
        "default": "./dist/babel.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts src/babel.ts src/vue.ts src/svelte.ts --format esm,cjs --dts --clean --sourcemap --target es2020",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aleandros/lightback.git",
    "directory": "packages/source"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/types": "^7.29.8",
    "@types/babel__core": "^7.20.5",
    "magic-string": "^0.30.21",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.43",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dom19": "npm:react-dom@^19.3.0",
    "react19": "npm:react@^19.3.0",
    "svelte": "^5.57.2",
    "vite": "^5.4.21",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "vite": "^5.4.0 || ^6.0.0 || ^7.0.0 || ^8.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    }
  }
}
