{
  "name": "lightback-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter playground run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "pnpm --filter e2e run e2e",
    "screenshots": "pnpm --filter e2e run screenshots"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}
